{
  "name": "rewardia",
  "version": "1.0.0",
  "main": "index.js",
  "author": "",
  "license": "ISC",
  "description": "",
  "scripts": {
    "js:dev": "rollup -c --watch --environment development",
    "js:build": "rollup -c --environment production",
    "css:dev": "npx @tailwindcss/cli -i src/styles/style.css -o public/styles/style.css --watch",
    "css:build": "npx @tailwindcss/cli -i src/styles/style.css -o public/styles/style.css --minify",
    "dev": "concurrently --names \"JS,CSS\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"npm run js:dev\" \"npm run css:dev\"",
    "build": "concurrently --names \"JS,CSS\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"npm run js:build\" \"npm run css:build\""
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "concurrently": "^9.2.0",
    "daisyui": "^5.0.50",
    "esbuild": "^0.25.9",
    "rollup": "^4.50.2"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.12",
    "alpinejs": "^3.14.9",
    "htmx.org": "^2.0.6",
    "tailwindcss": "^4.1.13"
  }
}
